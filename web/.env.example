# Copiar a .env y completar.
# Postgres de desarrollo: deploy/docker-compose.dev.yml (puerto 5433)
DATABASE_URL=postgres://firmatech:firmatech@127.0.0.1:5433/firmatech
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Correo transaccional (verificación y recuperar contraseña). Vacío en dev = se imprime en consola.
RESEND_API_KEY=
EMAIL_FROM=no-responder@firmatech.com.ar

# Login con Google (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web").
# URI de redirección autorizada: <NEXT_PUBLIC_SERVER_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
